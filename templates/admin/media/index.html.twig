{% extends 'base.html.twig' %}{% block title %}Média – {{ institution.shortName }}{% endblock %}{% block body %}<main id="main-content"><p><a href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">← Tartalom</a></p><h1>Médiafájlok</h1><p>JPEG, PNG, WebP vagy PDF, legfeljebb 5 MB. Az alt szöveg kötelező.</p>{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<button type="submit">Feltöltés</button>{{ form_end(form) }}<h2>Feltöltött fájlok</h2><ul>{% for asset in assets %}<li>{{ asset.originalName }} – {{ asset.mimeType }} – {{ asset.altText }}</li>{% else %}<li>Még nincs feltöltött fájl.</li>{% endfor %}</ul></main>{% endblock %}
