{% extends 'admin/base.html.twig' %}
{% block admin_title %}{{ isNew ? 'Új elem' : 'Szerkesztés' }}{% endblock %}
{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><a class="back-link" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">← Vissza a tartalmakhoz</a><h1>{{ isNew ? 'Új elem létrehozása' : 'Elem szerkesztése' }}</h1><p>A csillaggal jelölt mezők kitöltése kötelező.</p></div></div><div class="admin-form-card">{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<div class="form-actions"><a class="button button-quiet" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">Mégse</a><button class="button" type="submit">Mentés</button></div>{{ form_end(form) }}</div>{% if type == 'journey' and not isNew %}<section class="admin-list-card admin-section"><div class="admin-section-heading"><div><h2>Betegút lépései</h2><p>A beteg számára megjelenő sorrendben.</p></div><a class="button" href="{{ path('tenant_admin_journey_step_new',{institutionSlug:institution.slug,journeyId:entity.id}) }}">Új lépés</a></div><ol class="journey-admin-steps">{% for step in entity.steps %}<li><span>{{ step.position }}</span><div><strong>{{ step.title }}</strong><small>{% if step.building %}{{ step.building.name }}{% if step.floor %} · {{ step.floor.name }}{% endif %}{% if step.room %} · {{ step.room.name }}{% if step.room.number %} ({{ step.room.number }}){% endif %}{% endif %}{% elseif step.location %}{{ step.location }}{% else %}{{ step.description|slice(0,80) }}{% endif %}</small></div><a href="{{ path('tenant_admin_journey_step_edit',{institutionSlug:institution.slug,journeyId:entity.id,stepId:step.id}) }}">Szerkesztés</a></li>{% else %}<li class="empty-state">Ehhez a betegúthoz még nincs lépés.</li>{% endfor %}</ol></section>{% endif %}{% if not isNew %}<section class="danger-zone"><div><strong>Veszélyes művelet</strong><p>A törölt elem nem állítható vissza.</p></div><form method="post" action="{{ path('tenant_admin_crud_delete',{institutionSlug:institution.slug,type:type,id:entity.id}) }}" onsubmit="return confirm('Biztosan törlöd ezt az elemet?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ type ~ '_' ~ entity.id) }}"><button class="danger-button" type="submit">Elem törlése</button></form></section>{% endif %}</main>{% endblock %}
