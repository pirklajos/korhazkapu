{% extends 'admin/base.html.twig' %}
{% block admin_title %}{{ isNew ? 'Új elem' : 'Szerkesztés' }}{% endblock %}
{% block admin_body %}
{% set statusLabels={draft:'Piszkozat',medical_review:'Szakmai ellenőrzés',communication_review:'Kommunikációs ellenőrzés',approved:'Jóváhagyva',published:'Publikálva',expired:'Lejárt',archived:'Archiválva'} %}
<main id="main-content"><div class="admin-page-heading"><div><a class="back-link" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">← Vissza a tartalmakhoz</a><h1>{{ isNew ? 'Új elem létrehozása' : 'Elem szerkesztése' }}</h1><p>A csillaggal jelölt mezők kitöltése kötelező.</p></div>{% if entity.status is defined %}<span class="workflow-status workflow-status-{{ entity.status.value }}">{{ statusLabels[entity.status.value] }}</span>{% endif %}</div>
<div class="admin-form-card">{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<div class="form-actions"><a class="button button-quiet" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">Vissza</a>{% if canEditContent %}<button class="button" type="submit">Mentés</button>{% endif %}</div>{{ form_end(form) }}</div>
{% if entity.status is defined and not isNew %}<section class="workflow-panel admin-section"><div class="admin-section-heading"><div><span class="admin-eyebrow">Szerkesztői workflow</span><h2>Állapot és jóváhagyás</h2><p>A tartalom csak szabályos ellenőrzési folyamat után publikálható.</p></div></div>{% if workflowTransitions|length %}<div class="workflow-actions">{% for target in workflowTransitions %}<form method="post" action="{{ path('tenant_admin_content_transition',{institutionSlug:institution.slug,type:type,id:entity.id,target:target.value}) }}"><input type="hidden" name="_token" value="{{ csrf_token('transition_' ~ entity.id ~ '_' ~ target.value) }}">{% if target.value == 'draft' %}<label>Visszaküldés indoka<textarea name="comment" required placeholder="Írd le, mit kell javítani…"></textarea></label>{% endif %}<button class="button {{ target.value == 'draft' ? 'button-quiet' : '' }}" type="submit">{{ target.value == 'draft' ? 'Visszaküldés javításra' : statusLabels[target.value] ~ ' →' }}</button></form>{% endfor %}</div>{% else %}<p class="workflow-empty">Ebben az állapotban vagy ezzel a szerepkörrel nincs elérhető állapotváltás.</p>{% endif %}</section>
<section class="admin-list-card admin-section"><div class="admin-section-heading"><div><span class="admin-eyebrow">Előzmények</span><h2>Tartalomverziók</h2></div><span class="count-badge">{{ revisions|length }}</span></div><ol class="revision-list">{% for revision in revisions %}<li><span class="revision-number">v{{ revision.versionNumber }}</span><div><strong>{{ revision.summary ?: 'Automatikus tartalomverzió' }}</strong><small>{{ revision.createdAt|date('Y. m. d. H:i') }}{% if revision.author %} · {{ revision.author.displayName }}{% endif %}</small></div><form method="post" action="{{ path('tenant_admin_content_restore',{institutionSlug:institution.slug,type:type,id:entity.id,revisionId:revision.id}) }}" onsubmit="return confirm('Biztosan visszaállítod ezt a verziót piszkozatként?')"><input type="hidden" name="_token" value="{{ csrf_token('restore_' ~ revision.id) }}"><button class="button button-quiet">Visszaállítás</button></form></li>{% else %}<li class="empty-state">Még nincs mentett tartalomverzió.</li>{% endfor %}</ol></section>{% endif %}
{% if type == 'journey' and not isNew %}<section class="admin-list-card admin-section"><div class="admin-section-heading"><div><h2>Betegút lépései</h2><p>A beteg számára megjelenő sorrendben.</p></div><a class="button" href="{{ path('tenant_admin_journey_step_new',{institutionSlug:institution.slug,journeyId:entity.id}) }}">Új lépés</a></div><ol class="journey-admin-steps">{% for step in entity.steps %}<li><span>{{ step.position }}</span><div><strong>{{ step.title }}</strong><small>{% if step.building %}{{ step.building.name }}{% if step.floor %} · {{ step.floor.name }}{% endif %}{% if step.room %} · {{ step.room.name }}{% endif %}{% elseif step.location %}{{ step.location }}{% else %}{{ step.description|slice(0,80) }}{% endif %}</small></div><a href="{{ path('tenant_admin_journey_step_edit',{institutionSlug:institution.slug,journeyId:entity.id,stepId:step.id}) }}">Szerkesztés</a></li>{% else %}<li class="empty-state">Ehhez a betegúthoz még nincs lépés.</li>{% endfor %}</ol></section>{% endif %}
{% if not isNew %}<section class="danger-zone"><div><strong>Veszélyes művelet</strong><p>A törölt elem nem állítható vissza.</p></div><form method="post" action="{{ path('tenant_admin_crud_delete',{institutionSlug:institution.slug,type:type,id:entity.id}) }}" onsubmit="return confirm('Biztosan törlöd ezt az elemet?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ type ~ '_' ~ entity.id) }}"><button class="danger-button" type="submit">Elem törlése</button></form></section>{% endif %}</main>
{% endblock %}
