{% extends 'admin/base.html.twig' %}
{% block admin_title %}{{ isNew ? 'Új elem' : 'Szerkesztés' }}{% endblock %}
{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><a class="back-link" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">← Vissza a tartalmakhoz</a><h1>{{ isNew ? 'Új elem létrehozása' : 'Elem szerkesztése' }}</h1><p>A csillaggal jelölt mezők kitöltése kötelező.</p></div></div><div class="admin-form-card">{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<div class="form-actions"><a class="button button-quiet" href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">Mégse</a><button class="button" type="submit">Mentés</button></div>{{ form_end(form) }}</div>{% if not isNew %}<section class="danger-zone"><div><strong>Veszélyes művelet</strong><p>A törölt elem nem állítható vissza.</p></div><form method="post" action="{{ path('tenant_admin_crud_delete',{institutionSlug:institution.slug,type:type,id:entity.id}) }}" onsubmit="return confirm('Biztosan törlöd ezt az elemet?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ type ~ '_' ~ entity.id) }}"><button class="danger-button" type="submit">Elem törlése</button></form></section>{% endif %}</main>{% endblock %}
