{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'Új elem' : 'Szerkesztés' }} – {{ institution.shortName }}{% endblock %}
{% block body %}<main id="main-content"><p><a href="{{ path('tenant_admin_content',{institutionSlug:institution.slug}) }}">← Vissza</a></p><h1>{{ isNew ? 'Új elem' : 'Szerkesztés' }}</h1>{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<button type="submit">Mentés</button>{{ form_end(form) }}{% if not isNew %}<hr><form method="post" action="{{ path('tenant_admin_crud_delete',{institutionSlug:institution.slug,type:type,id:entity.id}) }}" onsubmit="return confirm('Biztosan törlöd ezt az elemet?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ type ~ '_' ~ entity.id) }}"><button class="danger-button" type="submit">Törlés</button></form>{% endif %}</main>{% endblock %}
