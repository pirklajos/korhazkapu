{% extends 'admin/base.html.twig' %}
{% block admin_title %}Betegút lépése{% endblock %}
{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><a class="back-link" href="{{ path('tenant_admin_crud_edit',{institutionSlug:institution.slug,type:'journey',id:journey.id}) }}">← Vissza a betegúthoz</a><span class="admin-eyebrow">{{ journey.title }}</span><h1>{{ isNew ? 'Új lépés' : 'Lépés szerkesztése' }}</h1></div></div><div class="admin-form-card">{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}<div class="form-actions"><a class="button button-quiet" href="{{ path('tenant_admin_crud_edit',{institutionSlug:institution.slug,type:'journey',id:journey.id}) }}">Mégse</a><button class="button">Mentés</button></div>{{ form_end(form) }}</div>{% if not isNew %}<section class="danger-zone"><div><strong>Lépés törlése</strong><p>A művelet nem vonható vissza.</p></div><form method="post" action="{{ path('tenant_admin_journey_step_delete',{institutionSlug:institution.slug,journeyId:journey.id,stepId:step.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_step_' ~ step.id) }}"><button class="danger-button">Törlés</button></form></section>{% endif %}</main>{% endblock %}
