{% extends 'admin/base.html.twig' %}{% block admin_title %}Keresés és visszajelzés{% endblock %}{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><span class="admin-eyebrow">{{ institution.shortName }}</span><h1>Keresés és visszajelzés</h1><p>Közérthető kifejezések és anonim betegvisszajelzések kezelése.</p></div></div><div class="admin-two-column"><section class="admin-form-card"><h2>Új szinonima</h2>{{ form_start(form) }}{{ form_widget(form) }}<button class="button">Mentés</button>{{ form_end(form) }}</section><section class="admin-list-card"><div class="admin-section-heading"><h2>Keresési szinonimák</h2><span class="count-badge">{{ synonyms|length }}</span></div><ul class="synonym-list">{% for item in synonyms %}<li><div><strong>{{ item.term }}</strong><small>{{ item.synonyms|join(', ') }}</small></div><form method="post" action="{{ path('tenant_admin_synonym_delete',{institutionSlug:institution.slug,id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_synonym_' ~ item.id) }}"><button class="media-delete">Törlés</button></form></li>{% else %}<li class="empty-state">Nincs szinonima.</li>{% endfor %}</ul></section></div><section class="admin-list-card admin-section"><div class="admin-section-heading"><h2>Legutóbbi visszajelzések</h2><span class="count-badge">{{ feedback|length }}</span></div><ul class="feedback-list">{% for item in feedback %}<li><span class="feedback-result {{ item.helpful ? 'is-positive' : 'is-negative' }}">{{ item.helpful ? 'Igen' : 'Nem' }}</span><div><strong>{{ item.pagePath }}</strong><small>{{ item.createdAt|date('Y. m. d. H:i') }}</small>{% if item.comment %}<p>{{ item.comment }}</p>{% endif %}</div></li>{% else %}<li class="empty-state">Még nincs visszajelzés.</li>{% endfor %}</ul></section></main>{% endblock %}
