{% extends 'admin/base.html.twig' %}{% block admin_title %}Központi sablonok{% endblock %}{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><span class="admin-eyebrow">Tartalomindítás</span><h1>Központi sablonok</h1><p>Ellenőrzött kiindulópontok, amelyek intézményi piszkozatként másolhatók.</p></div></div><div class="template-grid">{% for template in templates %}{% set adoption=adoptions[template.id ~ '']|default(null) %}<article><span class="template-version">v{{ template.version }}</span><h2>{{ template.title }}</h2><p>{{ template.summary }}</p>{% if adoption %}<small>Átvett verzió: v{{ adoption.adoptedVersion }}</small>{% if adoption.update %}<strong class="template-update">Frissítés érhető el</strong>{% endif %}{% endif %}<form method="post" action="{{ path('tenant_admin_template_adopt',{institutionSlug:institution.slug,id:template.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('adopt_template_' ~ template.id) }}"><button class="button">{{ adoption ? 'Sablon frissítése' : 'Másolás piszkozatként' }}</button></form></article>{% else %}<p>Nincs elérhető központi sablon.</p>{% endfor %}</div></main>{% endblock %}
