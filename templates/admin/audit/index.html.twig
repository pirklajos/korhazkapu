{% extends 'admin/base.html.twig' %}{% block admin_title %}Auditnapló{% endblock %}{% block admin_body %}<main id="main-content"><div class="admin-page-heading"><div><span class="admin-eyebrow">{{ institution.shortName }}</span><h1>Auditnapló</h1><p>Az intézményi tartalmak érdemi állapotváltozásai időrendben.</p></div></div><section class="admin-list-card"><div class="admin-section-heading"><h2>Legutóbbi események</h2><span class="count-badge">{{ events|length }}</span></div><ol class="audit-list">{% for event in events %}<li><span class="audit-icon" aria-hidden="true">{{ event.action == 'content_revision_restored' ? '↶' : '↗' }}</span><div><strong>{{ event.action == 'content_revision_restored' ? 'Korábbi verzió visszaállítva' : 'Tartalomállapot megváltoztatva' }}</strong><small>{{ event.createdAt|date('Y. m. d. H:i') }}{% if event.actor %} · {{ event.actor.displayName }}{% endif %}</small>{% if event.details.from is defined %}<p>{{ event.details.from }} → {{ event.details.to }}{% if event.details.comment %} · {{ event.details.comment }}{% endif %}</p>{% endif %}</div><code>{{ event.subjectId|slice(0,8) }}</code></li>{% else %}<li class="empty-state">Még nincs naplózott esemény.</li>{% endfor %}</ol></section></main>{% endblock %}
