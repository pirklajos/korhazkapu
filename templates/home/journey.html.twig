{% extends 'base.html.twig' %}
{% block title %}{{ journey.title }} – {{ institution.shortName }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% if institution.theme %}<style>:root { {% for name, value in institution.theme.cssVariables %}{{ name }}: {{ value }};{% endfor %} }</style>{% endif %}{% endblock %}
{% block body %}
<header class="public-header"><div class="public-utility"><div class="public-container"><span>Hivatalos intézményi tájékoztató oldal</span><a href="#accessibility">Akadálymentesség</a></div></div><div class="public-navbar public-container"><a class="public-logo" href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}"><span aria-hidden="true">+</span><span><strong>{{ institution.shortName }}</strong><small>{{ institution.name }}</small></span></a><nav aria-label="Fő navigáció"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#services">Ellátások</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#sites">Telephelyek</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#journeys">Betegutak</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#contact">Kapcsolat</a></nav></div></header>
<main id="main-content" class="public-main"><section class="journey-hero"><div class="public-container"><nav class="public-breadcrumb" aria-label="Morzsanavigáció"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#journeys">Betegutak</a><span>›</span><span>{{ journey.title }}</span></nav><span class="public-kicker">Betegút lépésről lépésre</span><h1>{{ journey.title }}</h1>{% if journey.summary %}<p>{{ journey.summary }}</p>{% endif %}</div></section>
<section class="public-section public-container journey-detail"><aside><strong>Felkészülési útmutató</strong><p>Haladjon végig a lépéseken sorrendben. A helyszíni táblák és munkatársaink is segítik a tájékozódást.</p></aside><ol class="journey-timeline">
{% for step in journey.steps %}<li><span class="journey-marker">{{ step.position }}</span><article><h2>{{ step.title }}</h2><p>{{ step.description }}</p>{% if step.building or step.location %}<div class="journey-location"><strong>Hová kell menni?</strong>{% if step.building %}<span>{{ step.building.name }}{% if step.floor %} · {{ step.floor.name }}{% endif %}{% if step.room %} · {{ step.room.name }}{% if step.room.number %} ({{ step.room.number }}){% endif %}{% endif %}</span>{% endif %}{% if step.location %}<small>{{ step.location }}</small>{% endif %}</div>{% endif %}{% if step.action %}<div class="journey-action"><strong>Teendő</strong><p>{{ step.action }}</p></div>{% endif %}{% if step.requiredDocuments|length %}<div><strong>Szükséges dokumentumok</strong><ul>{% for document in step.requiredDocuments %}<li>{{ document }}</li>{% endfor %}</ul></div>{% endif %}</article></li>{% else %}<li>Ehhez a betegúthoz még nem tartoznak lépések.</li>{% endfor %}
</ol></section></main>
<footer id="accessibility" class="public-footer"><div class="public-container"><div><strong>{{ institution.name }}</strong><p>{{ institution.centralAddress }}</p></div><div><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Vissza a főoldalra</a><span>DEMO környezet</span></div></div></footer>
{% endblock %}
