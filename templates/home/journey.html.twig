{% extends 'base.html.twig' %}
{% block title %}{{ journey.title }} – {{ institution.shortName }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% if institution.theme %}<style>:root { {% for name, value in institution.theme.cssVariables %}{{ name }}: {{ value }};{% endfor %} }</style>{% endif %}{% endblock %}
{% block body %}
<header class="public-header"><div class="public-utility"><div class="public-container"><span>Hivatalos intézményi tájékoztató oldal</span><a href="#accessibility">Akadálymentesség</a></div></div><div class="public-navbar public-container"><a class="public-logo" href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}"><span aria-hidden="true">+</span><span><strong>{{ institution.shortName }}</strong><small>{{ institution.name }}</small></span></a><nav aria-label="Fő navigáció"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#services">Ellátások</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#sites">Telephelyek</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#journeys">Betegutak</a><a href="#journey-help">Kapcsolat</a></nav></div></header>
<main id="main-content" class="public-main">
<section class="journey-hero"><div class="public-container"><nav class="public-breadcrumb" aria-label="Morzsanavigáció"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#journeys">Betegutak</a><span>›</span><span aria-current="page">{{ journey.title }}</span></nav><div class="journey-hero-layout"><div><span class="public-kicker">Felkészülési útmutató</span><h1>{{ journey.title }}</h1>{% if journey.summary %}<p>{{ journey.summary }}</p>{% endif %}</div><div class="journey-hero-mark" aria-hidden="true"><span>✓</span><small>lépésről<br>lépésre</small></div></div></div></section>
<div class="journey-overview"><div class="public-container"><div><span class="journey-overview-icon" aria-hidden="true">☷</span><span><small>Az útmutató hossza</small><strong>{{ journey.steps|length }} lépés</strong></span></div><div><span class="journey-overview-icon" aria-hidden="true">◎</span><span><small>Kinek szól?</small><strong>{{ journey.targetAudience ?: 'Betegeknek és kísérőknek' }}</strong></span></div><div><span class="journey-overview-icon" aria-hidden="true">i</span><span><small>Használat</small><strong>Kövesse a számozott lépéseket</strong></span></div></div></div>
<section class="public-section public-container journey-detail"><aside class="journey-guide"><span class="journey-guide-symbol" aria-hidden="true">i</span><strong>Mielőtt elindul</strong><p>Olvassa végig az útmutatót, és készítse össze a felsorolt dokumentumokat. A helyszínen munkatársaink is segítenek.</p><a href="#journey-help">Segítséget kérek →</a></aside><div><div class="journey-content-heading"><span class="public-kicker">Az Ön útvonala</span><h2>Teendők sorrendben</h2><p>Minden lépésnél megtalálja, hová kell mennie és mire lesz szüksége.</p></div><ol class="journey-timeline">
{% for step in journey.steps %}<li><span class="journey-marker"><small>Lépés</small>{{ step.position }}</span><article class="journey-step-card"><div class="journey-step-heading"><span>{{ loop.index }} / {{ journey.steps|length }}</span><h3>{{ step.title }}</h3></div><p class="journey-description">{{ step.description }}</p><div class="journey-step-details">
{% if step.building or step.location %}<section class="journey-detail-box journey-location"><span class="journey-detail-icon" aria-hidden="true">⌖</span><div><strong>Hová kell menni?</strong>{% if step.building %}<span>{{ step.building.name }}{% if step.floor %}<b>›</b>{{ step.floor.name }}{% endif %}{% if step.room %}<b>›</b>{{ step.room.name }}{% if step.room.number %} ({{ step.room.number }}){% endif %}{% endif %}</span>{% endif %}{% if step.location %}<small>{{ step.location }}</small>{% endif %}</div></section>{% endif %}
{% if step.action %}<section class="journey-detail-box journey-action"><span class="journey-detail-icon" aria-hidden="true">✓</span><div><strong>Az Ön teendője</strong><p>{{ step.action }}</p></div></section>{% endif %}
{% if step.requiredDocuments|length %}<section class="journey-detail-box journey-documents"><span class="journey-detail-icon" aria-hidden="true">▤</span><div><strong>Ezeket hozza magával</strong><ul>{% for document in step.requiredDocuments %}<li>{{ document }}</li>{% endfor %}</ul></div></section>{% endif %}
</div></article></li>{% else %}<li class="journey-empty">Ehhez a betegúthoz még nem tartoznak lépések.</li>{% endfor %}
</ol></div></section>
<section id="journey-help" class="journey-help"><div class="public-container"><div><span class="public-kicker">Elakadt vagy kérdése van?</span><h2>Segítünk eligazodni.</h2><p>Keresse betegirányításunkat, ha bizonytalan a helyszínben vagy a felkészülésben.</p></div><div>{% if institution.phone %}<a href="tel:{{ institution.phone|replace({' ': ''}) }}"><small>Telefon</small><strong>{{ institution.phone }}</strong></a>{% endif %}{% if institution.email %}<a href="mailto:{{ institution.email }}"><small>E-mail</small><strong>{{ institution.email }}</strong></a>{% endif %}</div></div></section>
</main><footer id="accessibility" class="public-footer"><div class="public-container"><div><strong>{{ institution.name }}</strong><p>{{ institution.centralAddress }}</p></div><div><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Vissza a főoldalra</a><span>DEMO környezet</span></div></div></footer>
{% endblock %}
