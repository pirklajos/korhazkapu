{% extends 'base.html.twig' %}{% block title %}Az oldal nem található – KórházKapu{% endblock %}{% block body %}<main id="main-content" class="error-page"><span aria-hidden="true">404</span><h1>Ez az oldal nem található</h1><p>Lehet, hogy a hivatkozás megváltozott, vagy a keresett tájékoztató már nem érhető el.</p><div>{% if app.request.attributes.get('institutionSlug') %}<a class="button" href="{{ path('tenant_home',{institutionSlug:app.request.attributes.get('institutionSlug')}) }}">Vissza az intézmény főoldalára</a>{% else %}<a class="button" href="{{ path('platform_home') }}">Vissza a főoldalra</a>{% endif %}</div></main>{% endblock %}
