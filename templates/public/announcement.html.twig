{% extends 'public/base.html.twig' %}{% block public_title %}{{ announcement.title }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero announcement-hero-{{ announcement.type }}"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_announcements',{institutionSlug:institution.slug}) }}">Közlemények</a><span>›</span><span>{{ announcement.title }}</span></nav><span class="public-kicker">{{ announcement.type == 'urgent' ? 'Sürgős tájékoztatás' : (announcement.type == 'warning' ? 'Fontos változás' : 'Közlemény') }}</span><h1>{{ announcement.title }}</h1><p>{{ announcement.summary }}</p></div></section><article class="public-section public-container prose-content"><p>{{ announcement.body|nl2br }}</p></article>{% endblock %}
