{% extends 'public/base.html.twig' %}{% block public_title %}Keresés – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero search-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><span>Keresés</span></nav><span class="public-kicker">Keresés az intézményben</span><h1>Mit szeretne megtalálni?</h1><form class="search-page-form" role="search" method="get"><label for="search-query">Keresőkifejezés</label><div><input id="search-query" type="search" name="q" value="{{ query }}" placeholder="Például: szívvizsgálat, labor, parkolás…" required><button>Keresés</button></div></form></div></section><section class="public-section public-container search-results">{% if query|length < 2 %}<div class="public-empty"><strong>Írjon be legalább két karaktert.</strong><p>Kereshet ellátásra, osztályra, telephelyre vagy tájékoztatóra.</p></div>{% elseif results|length %}<div class="public-section-heading"><div><span class="public-kicker">{{ results|length }} találat</span><h2>Találatok erre: „{{ query }}”</h2></div></div><ol>{% for result in results %}<li><a href="{{ result.url }}"><span>{{ result.type }}</span><h2>{{ result.title }}</h2><p>{{ result.summary }}</p><b>Részletek →</b></a></li>{% endfor %}</ol>{% else %}<div class="search-empty"><span aria-hidden="true">⌕</span><h2>Nem találtunk pontos egyezést</h2><p>Próbálja egyszerűbb kifejezéssel, vagy kérjen segítséget betegirányításunktól.</p><div><a class="button" href="{{ path('tenant_contacts',{institutionSlug:institution.slug}) }}">Kapcsolat keresése</a><a class="button button-quiet" href="{{ path('tenant_services',{institutionSlug:institution.slug}) }}">Ellátások böngészése</a></div></div>{% endif %}</section>{% endblock %}
