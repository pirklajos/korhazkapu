{% extends 'public/base.html.twig' %}{% block public_title %}{{ site.name }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_sites',{institutionSlug:institution.slug}) }}">Telephelyek</a><span>›</span><span>{{ site.name }}</span></nav><span class="public-kicker">Telephely</span><h1>{{ site.name }}</h1><p>{{ site.address }}</p>{% if site.mapUrl %}<a class="button button-secondary" href="{{ site.mapUrl }}" rel="noopener">Megnyitás térképen ↗</a>{% endif %}</div></section><section class="public-section public-container public-content-layout"><article><h2>Megközelítés és épületek</h2>{% if site.accessibility %}<div class="public-info-box"><strong>♿ Akadálymentes megközelítés</strong><p>{{ site.accessibility }}</p></div>{% endif %}<div class="public-simple-list">{% for building in buildings %}<div><span>Épület</span><strong>{{ building.name }}</strong>{% if building.code %}<small>{{ building.code }} jelzés</small>{% endif %}</div>{% endfor %}</div></article><aside><h2>Itt elérhető ellátások</h2><ul class="public-link-list">{% for service in services %}<li><a href="{{ path('tenant_service_show',{institutionSlug:institution.slug,slug:service.slug}) }}">{{ service.name }} →</a></li>{% else %}<li>Nincs megadott ellátás.</li>{% endfor %}</ul></aside></section>{% endblock %}
