{% extends 'public/base.html.twig' %}{% block public_title %}{{ service.name }} – {{ institution.shortName }}{% endblock %}{% block public_body %}
<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_services',{institutionSlug:institution.slug}) }}">Ellátások</a><span>›</span><span>{{ service.name }}</span></nav><span class="public-kicker">Ellátás</span><h1>{{ service.name }}</h1><p>{{ service.summary }}</p></div></section>
<section class="public-section public-container public-content-layout service-overview"><article><h2>Helyszín és odatalálás</h2>{% if service.site %}<div class="service-location"><div class="service-location-address"><span class="service-location-pin" aria-hidden="true">⌖</span><div><small>Telephely</small><strong>{{ service.site.name }}</strong><p>{{ service.site.address }}</p></div></div><ol class="location-path">{% if service.building %}<li><span>1</span><div><small>Épület</small><strong>{{ service.building.name }}</strong></div></li>{% endif %}{% if service.floor %}<li><span>2</span><div><small>Emelet / szint</small><strong>{{ service.floor.name }}</strong></div></li>{% endif %}{% if service.room %}<li><span>3</span><div><small>Szoba / helyiség</small><strong>{{ service.room.name }}{% if service.room.number %} ({{ service.room.number }}){% endif %}</strong></div></li>{% endif %}</ol>{% if service.locationDirections %}<div class="location-directions"><span>→</span><div><strong>Így talál oda</strong><p>{{ service.locationDirections }}</p></div></div>{% endif %}{% if service.site.accessibility %}<p class="location-accessibility">♿ {{ service.site.accessibility }}</p>{% endif %}</div>{% else %}<p>A pontos helyszín egyeztetés alatt áll.</p>{% endif %}</article><aside><h2>Kapcsolat</h2>{% for contact in contacts %}<div class="contact-row"><small>{{ contact.label }}</small><strong>{{ contact.value }}</strong>{% if contact.availability %}<span>{{ contact.availability }}</span>{% endif %}</div>{% else %}<p>Ehhez az ellátáshoz nincs külön elérhetőség.</p>{% endfor %}</aside></section>
{% for guide in guides %}<section class="service-guide-section"><div class="public-container">{% include 'public/_guide_content.html.twig' with {guide:guide} only %}<a class="standalone-guide-link" href="{{ path('tenant_guide_show',{institutionSlug:institution.slug,slug:guide.slug}) }}">Útmutató megnyitása külön oldalon →</a></div></section>{% endfor %}{% endblock %}
