{% extends 'public/base.html.twig' %}
{% block public_title %}{{ service.name }} – {{ institution.shortName }}{% endblock %}
{% block public_body %}
<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><a href="{{ path('tenant_services',{institutionSlug:institution.slug}) }}">Ellátások</a><span>›</span><span>{{ service.name }}</span></nav><span class="public-kicker">Ellátás</span><h1>{{ service.name }}</h1><p>{{ service.summary }}</p>{% if service.department %}<a class="subhero-link" href="{{ path('tenant_department_show',{institutionSlug:institution.slug,slug:service.department.slug}) }}">{{ service.department.name }} →</a>{% endif %}</div></section>
<section class="public-section public-container public-content-layout service-overview"><article><h2>Helyszín és tudnivalók</h2>{% if service.site %}<div class="public-location-card"><span>⌖</span><div><strong>{{ service.site.name }}</strong><p>{{ service.site.address }}</p>{% if service.building %}<small>{{ service.building.name }}{% if service.floor %} · {{ service.floor.name }}{% endif %}{% if service.room %} · {{ service.room.name }}{% if service.room.number %} ({{ service.room.number }}){% endif %}{% endif %}</small>{% endif %}</div></div>{% else %}<p>A pontos helyszín egyeztetés alatt áll.</p>{% endif %}</article><aside><h2>Kapcsolat</h2>{% for contact in contacts %}<div class="contact-row"><small>{{ contact.label }}</small><strong>{{ contact.value }}</strong>{% if contact.availability %}<span>{{ contact.availability }}</span>{% endif %}</div>{% else %}<p>Ehhez az ellátáshoz nincs külön elérhetőség.</p>{% endfor %}</aside></section>
{% for guide in guides %}<section class="service-guide-section"><div class="public-container">{% include 'public/_guide_content.html.twig' with {guide:guide} only %}<a class="standalone-guide-link" href="{{ path('tenant_guide_show',{institutionSlug:institution.slug,slug:guide.slug}) }}">Útmutató megnyitása külön oldalon →</a></div></section>{% endfor %}
{% endblock %}
