{% extends 'public/base.html.twig' %}{% block public_title %}Kapcsolat – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><span>Kapcsolat</span></nav><span class="public-kicker">Elérhetőségek</span><h1>Miben segíthetünk?</h1><p>Keresse meg az ügyéhez vagy ellátásához tartozó elérhetőséget.</p></div></section><section class="public-section public-container"><div class="contact-directory">{% if institution.phone %}<a href="tel:{{ institution.phone|replace({' ':''}) }}"><span>☎</span><div><small>Központi telefonszám</small><strong>{{ institution.phone }}</strong></div></a>{% endif %}{% if institution.email %}<a href="mailto:{{ institution.email }}"><span>✉</span><div><small>Központi e-mail</small><strong>{{ institution.email }}</strong></div></a>{% endif %}{% for contact in contacts %}<div><span>{{ contact.type == 'email' ? '✉' : '☎' }}</span><div><small>{{ contact.label }}</small><strong>{{ contact.value }}</strong>{% if contact.service %}<a href="{{ path('tenant_service_show',{institutionSlug:institution.slug,slug:contact.service.slug}) }}">{{ contact.service.name }}</a>{% endif %}{% if contact.availability %}<p>{{ contact.availability }}</p>{% endif %}</div></div>{% endfor %}</div></section>{% endblock %}
