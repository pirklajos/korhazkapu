{% extends 'public/base.html.twig' %}{% block public_title %}{{ department.name }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><span>{{ department.name }}</span></nav><span class="public-kicker">Osztály és szervezeti egység</span><h1>{{ department.name }}</h1><p>{{ department.summary }}</p></div></section><section class="public-section public-container public-content-layout"><article><h2>Kapcsolódó ellátások</h2><div class="public-link-cards">{% for service in services %}<a href="{{ path('tenant_service_show',{institutionSlug:institution.slug,slug:service.slug}) }}"><strong>{{ service.name }}</strong><span>Részletek →</span></a>{% else %}<p>Nincs megadott ellátás.</p>{% endfor %}</div></article><aside><h2>Elérhetőségek</h2>{% for contact in contacts %}<div class="contact-row"><small>{{ contact.label }}</small><strong>{{ contact.value }}</strong>{% if contact.availability %}<span>{{ contact.availability }}</span>{% endif %}</div>{% else %}<p>Nincs külön elérhetőség megadva.</p>{% endfor %}</aside></section>{% endblock %}
