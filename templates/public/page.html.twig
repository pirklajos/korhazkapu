{% extends 'public/base.html.twig' %}{% block public_title %}{{ page.title }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><span>{{ page.title }}</span></nav><span class="public-kicker">Betegtájékoztató</span><h1>{{ page.title }}</h1><p>{{ page.summary }}</p></div></section><article class="public-section public-container prose-content">{% for block in page.content.blocks|default([]) %}{% if block.type == 'text' %}<p>{{ block.text }}</p>{% elseif block.type == 'heading' %}<h2>{{ block.text }}</h2>{% elseif block.type == 'list' %}<ul>{% for item in block.items|default([]) %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}{% else %}<p>A részletes tájékoztató feltöltése folyamatban van.</p>{% endfor %}</article>{% endblock %}
