{% extends 'public/base.html.twig' %}{% block public_title %}{{ title }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span><span>{{ title }}</span></nav><span class="public-kicker">Betegtájékoztatás</span><h1>{{ title }}</h1><p>{{ intro }}</p></div></section><section class="public-section public-container"><div class="public-directory-grid">{% for item in items %}{% if kind == 'sites' %}{% set url=path('tenant_site_show',{institutionSlug:institution.slug,slug:item.slug}) %}{% set name=item.name %}{% set text=item.address %}{% elseif kind == 'services' %}{% set url=path('tenant_service_show',{institutionSlug:institution.slug,slug:item.slug}) %}{% set name=item.name %}{% set text=item.summary %}{% else %}{% set url=path('tenant_announcement_show',{institutionSlug:institution.slug,slug:item.slug}) %}{% set name=item.title %}{% set text=item.summary ?: item.body|slice(0,150) %}{% endif %}<a href="{{ url }}"><span class="directory-icon" aria-hidden="true">{{ kind == 'sites' ? '⌖' : (kind == 'services' ? '✚' : '!') }}</span><div><h2>{{ name }}</h2><p>{{ text }}</p>{% if kind == 'services' and item.site %}<small>{{ item.site.name }}</small>{% endif %}</div><span class="directory-arrow">→</span></a>{% else %}<div class="public-empty"><strong>Nincs megjeleníthető tartalom.</strong><p>Nézzen vissza később, vagy kérjen segítséget betegirányításunktól.</p></div>{% endfor %}</div></section>{% endblock %}
