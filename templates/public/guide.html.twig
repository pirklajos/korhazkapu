{% extends 'public/base.html.twig' %}{% block public_title %}{{ guide.title }} – {{ institution.shortName }}{% endblock %}{% block public_body %}<section class="public-subhero"><div class="public-container"><nav class="content-breadcrumb"><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}">Főoldal</a><span>›</span>{% if guide.service %}<a href="{{ path('tenant_service_show',{institutionSlug:institution.slug,slug:guide.service.slug}) }}">{{ guide.service.name }}</a><span>›</span>{% endif %}<span>{{ guide.title }}</span></nav><span class="public-kicker">Vizsgálati felkészülés</span><h1>{{ guide.title }}</h1><p>{{ guide.summary }}</p></div></section><section class="public-section public-container guide-layout"><article>{% if guide.purpose %}<section><h2>A vizsgálat célja</h2><p>{{ guide.purpose }}</p></section>{% endif %}{% if guide.discomfort %}<section><h2>Mire számíthat?</h2><p>{{ guide.discomfort }}</p></section>{% endif %}{% if guide.preparation.steps is defined and guide.preparation.steps|length %}<section><h2>Felkészülés lépésről lépésre</h2><ol class="guide-steps">{% for step in guide.preparation.steps %}<li><span>{{ loop.index }}</span>{{ step }}</li>{% endfor %}</ol></section>{% endif %}{% if guide.aftercare.steps is defined and guide.aftercare.steps|length %}<section><h2>Vizsgálat utáni teendők</h2><ul>{% for step in guide.aftercare.steps %}<li>{{ step }}</li>{% endfor %}</ul></section>{% endif %}</article><aside><h2>Gyors áttekintés</h2>{% if guide.durationMinutes %}<div><small>Várható időtartam</small><strong>{{ guide.durationMinutes }} perc</strong></div>{% endif %}<div><small>Beutaló</small><strong>{{ guide.referralRequired ? 'Szükséges' : 'Nem szükséges' }}</strong></div><div><small>Előjegyzés</small><strong>{{ guide.appointmentRequired ? 'Szükséges' : 'Nem szükséges' }}</strong></div><div><small>Kísérő</small><strong>{{ guide.companionRequired ? 'Szükséges' : 'Nem szükséges' }}</strong></div>{% if guide.preparation.fasting is defined %}<div><small>Éhgyomor</small><strong>{{ guide.preparation.fasting ? 'Szükséges' : 'Nem szükséges' }}</strong></div>{% endif %}{% if guide.requiredDocuments|length %}<h3>Hozza magával</h3><ul>{% for document in guide.requiredDocuments %}<li>{{ document }}</li>{% endfor %}</ul>{% endif %}</aside></section>{% endblock %}
