<section id="page-feedback" class="page-feedback"><div><strong>Megtalálta, amit keresett?</strong><p>Visszajelzése segít érthetőbbé tenni az oldalt.</p></div>{% for message in app.flashes('feedback_success') %}<p class="feedback-thanks" role="status">{{ message }}</p>{% else %}<form method="post" action="{{ path('tenant_feedback',{institutionSlug:institution.slug}) }}"><input type="hidden" name="page" value="{{ app.request.pathInfo }}"><input type="hidden" name="_token" value="{{ csrf_token('feedback_' ~ app.request.pathInfo) }}"><label class="visually-hidden" for="feedback-comment">Megjegyzés (nem kötelező)</label><input id="feedback-comment" name="comment" maxlength="2000" placeholder="Megjegyzés (nem kötelező)"><button name="helpful" value="yes">Igen</button><button class="feedback-no" name="helpful" value="no">Nem</button></form>{% endfor %}</section>
