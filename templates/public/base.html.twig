{% extends 'base.html.twig' %}
{% block title %}{% block public_title %}{{ institution.name }}{% endblock %}{% endblock %}
{% block stylesheets %}{{ parent() }}{% if institution.theme %}<style>:root { {% for name,value in institution.theme.cssVariables %}{{ name }}:{{ value }};{% endfor %} }</style>{% endif %}{% endblock %}
{% block body %}<header class="public-header"><div class="public-utility"><div class="public-container"><span>Hivatalos intézményi tájékoztató oldal</span><a href="#accessibility">Akadálymentesség</a></div></div><div class="public-navbar public-container"><a class="public-logo" href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}"><span aria-hidden="true">+</span><span><strong>{{ institution.shortName }}</strong><small>{{ institution.name }}</small></span></a><nav aria-label="Fő navigáció"><a href="{{ path('tenant_services',{institutionSlug:institution.slug}) }}">Ellátások</a><a href="{{ path('tenant_sites',{institutionSlug:institution.slug}) }}">Telephelyek</a><a href="{{ path('tenant_home',{institutionSlug:institution.slug}) }}#journeys">Betegutak</a><a href="{{ path('tenant_contacts',{institutionSlug:institution.slug}) }}">Kapcsolat</a></nav></div></header><main id="main-content" class="public-main">{% block public_body %}{% endblock %}</main><footer id="accessibility" class="public-footer"><div class="public-container"><div><strong>{{ institution.name }}</strong><p>{{ institution.centralAddress }}</p></div><div><a href="{{ path('tenant_contacts',{institutionSlug:institution.slug}) }}">Kapcsolat</a>{% if institution.privacyUrl %}<a href="{{ institution.privacyUrl }}">Adatkezelés</a>{% endif %}<span>DEMO környezet</span></div></div></footer>{% endblock %}
